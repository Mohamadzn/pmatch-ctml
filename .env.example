# Copy to .env and fill in. Never commit .env. Commands read it from the project folder.

# Azure Document Intelligence (prebuilt-layout, markdown output)
DOCUMENTINTELLIGENCE_ENDPOINT=https://<your-di-resource>.cognitiveservices.azure.com/
# Leave empty to sign in with Microsoft Entra ID (DefaultAzureCredential, for example after `az login`).
DOCUMENTINTELLIGENCE_KEY=
# Optional analysis features, comma separated, for example ocrHighResolution
DI_FEATURES=

# Azure AI Foundry model deployment, called through the resource's OpenAI v1 endpoint.
# A resource URL or a Foundry project URL also works: the v1 URL is derived from it.
FOUNDRY_OPENAI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/openai/v1/
# The deployment name (not the model family name)
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.6-terra
# Leave empty to sign in with Microsoft Entra ID.
FOUNDRY_API_KEY=
# Optional reasoning effort the deployment supports (for example low, medium or high). Empty sends none.
FOUNDRY_REASONING_EFFORT=

# Optional settings (defaults shown)
# PMATCH_RUNS_DIR=runs
# PMATCH_CACHE_DIR=.cache/pmatch
# PMATCH_MAX_PARALLEL_AGENTS=4
# PMATCH_AGENT_TIMEOUT_SECONDS=600
# PMATCH_METADATA_PAGES=5
# PMATCH_DESIGN_CONTEXT_CHARS=60000
# PMATCH_REGISTRY_TIMEOUT_SECONDS=30
# PMATCH_OMIT_CATEGORIES=consent,oral administration,laboratory value,contraception/pregnancy,investigator judgment,optional sub-study
# PMATCH_LOG_LEVEL=INFO
# Agent layout: v5 (supervisor workflow with eight specialist agents) or compact (one agent per criterion)
# PMATCH_AGENT_LAYOUT=v5
# Targeted repair rounds after the coverage comparison and the resolver (v5 only)
# PMATCH_MAX_REPAIR_ROUNDS=1
# Resolver / critic agent on or off (v5 only)
# PMATCH_RESOLVER=1
